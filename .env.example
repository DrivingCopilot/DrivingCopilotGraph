# 이 파일을 복사해 .env 로 만들고 값을 채우세요.
#   cp .env.example .env
# core/config.py 의 NEO4J_* / QDRANT_* 기본값을 덮어쓸 때만 지정하면 됩니다.

# --- Neo4j (Graph RAG) ---
# 사용자명은 docker-compose 에서 neo4j 로 고정. 아래 비밀번호와 반드시 일치해야 함.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j
GRAPH_MAX_RESULTS=20

# --- Qdrant (Vector RAG) — 서버 모드 사용할 때만 ---
# QDRANT_URL=http://localhost:6333
